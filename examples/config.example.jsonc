// Example openclaw.json snippet for token-footer-injector v6.
{
  "plugins": {
    "allow": [
      "token-footer-injector"
    ],
    "entries": {
      "token-footer-injector": {
        "enabled": true,
        "config": {
          // Agent IDs that should not receive token footers.
          "skipAgents": [],

          // Channel IDs or channel labels that should not receive token footers.
          "skipChannels": [],

          // If content + footer exceeds this length, keep content and skip the
          // footer. The plugin never truncates message content.
          "maxMessageLength": 1900,

          // Emit diagnostic logs for hook matching and footer correction.
          "debug": false
        }
      }
    },
    "load": {
      "paths": [
        "/Users/YOU/.openclaw/plugins/token-footer-injector"
      ]
    }
  }
}
